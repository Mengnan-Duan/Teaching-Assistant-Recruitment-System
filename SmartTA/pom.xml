<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.bupt</groupId>
    <artifactId>smartta</artifactId>
    <version>3.0</version>
    <packaging>jar</packaging>

    <name>Smart-TA Unit Tests</name>
    <description>
        Smart-TA TA Recruitment System — JUnit 5 Unit Test Suite.
        Covers model classes (Application / Position / TAPplicant / MoTaMessage / User / SystemLog),
        and performs mock testing of ApiServlet core business logic (state transitions,
        permission checks, API endpoints).
    </description>

    <!-- ============================================================
         Properties
         ============================================================ -->
    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Test report encoding -->
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <!-- Dependency versions -->
        <junit.version>5.11.4</junit.version>
        <mockito.version>5.14.2</mockito.version>
        <assertj.version>3.27.3</assertj.version>
    </properties>

    <!-- ============================================================
         Dependency Management
         ============================================================ -->
    <dependencies>
        <!-- ── JUnit 5 (JUnit Jupiter) ── -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- JUnit 5 Parameterized Test Support -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-params</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- ── Mockito (mock objects) ── -->
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>${mockito.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- Mockito JUnit 5 Integration (MockitoExtension) -->
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <version>${mockito.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- ── AssertJ (fluent assertions) ── -->
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${assertj.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- ── Servlet API (provided by Tomcat; stub for testing) ── -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <version>6.0.0</version>
            <scope>provided</scope>
        </dependency>

        <!-- ── Jackson (JSON processing; needed by both production code and tests) ── -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.17.3</version>
            <!-- No scope: defaults to compile so production code can use it -->
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
            <version>2.17.3</version>
        </dependency>

        <!-- ── Project source code (compiled via sourceDirectory config) ── -->
    </dependencies>

    <!-- ============================================================
         Build Configuration
         ============================================================ -->
    <build>
        <!-- Main source directory -->
        <sourceDirectory>src/main/java</sourceDirectory>

        <testResources>
            <testResource>
                <!-- Test resource files (copies of JSON files from data/) -->
                <directory>src/test/resources</directory>
                <includes>
                    <include>**/*.json</include>
                </includes>
            </testResource>
        </testResources>

        <plugins>
            <!-- ── Maven Compiler Plugin ── -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <source>17</source>
                    <target>17</target>
                    <encoding>UTF-8</encoding>
                    <!-- Compile output to WEB-INF/classes for direct Tomcat class loading -->
                    <outputDirectory>${project.basedir}/src/main/webapp/WEB-INF/classes</outputDirectory>
                    <!-- Warnings are not treated as errors (developer-friendly) -->
                    <failOnWarning>false</failOnWarning>
                </configuration>
            </plugin>

            <!-- ── Maven Surefire Plugin (run tests) ── -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
                <configuration>
                    <encoding>UTF-8</encoding>
                    <!-- Execute test classes in parallel (faster) -->
                    <parallel>classes</parallel>
                    <useModulePath>false</useModulePath>
                </configuration>
            </plugin>

            <!-- ── JaCoCo Plugin (code coverage report) ── -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.12</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals><goal>prepare-agent</goal></goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals><goal>report</goal></goals>
                    </execution>
                </executions>
            </plugin>

            <!-- ── Maven Surefire Report Plugin (generate HTML test reports) ── -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-report-plugin</artifactId>
                <version>3.5.2</version>
                <configuration>
                    <outputName>TEST-results</outputName>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
